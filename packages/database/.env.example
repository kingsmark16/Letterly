# Runtime queries should use Neon’s pooled connection string.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=verify-full&schema=public"

# Prisma migrations should use Neon’s direct, non-pooled connection string.
DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=verify-full&schema=public"
