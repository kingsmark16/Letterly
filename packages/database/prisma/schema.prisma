generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CatalogStatus {
  ACTIVE
  INACTIVE
}

enum UserRole {
  CREATOR
  ADMIN
}

enum ModerationStatus {
  ACTIVE
  DISABLED
}

enum ModerationTargetType {
  PAGE
  USER
  REPORT
  APPEAL
}

enum ModerationActionType {
  REPORT_REVIEW
  REPORT_DISMISS
  REPORT_REOPEN
  PAGE_DISABLE
  PAGE_RESTORE
  USER_DISABLE
  USER_RESTORE
  APPEAL_CREATE
  APPEAL_ACCEPT
  APPEAL_REJECT
}

enum AppealStatus {
  REQUESTED
  ACCEPTED
  REJECTED
}

enum AuditTargetType {
  PAGE
  USER
  REPORT
  APPEAL
  SYSTEM
}

enum AuditEventType {
  AUTH_SIGN_IN_SUCCEEDED
  AUTH_SIGN_IN_DENIED
  ADMIN_BOOTSTRAPPED
  REPORT_CREATED
  REPORT_REVIEWED
  REPORT_DISMISSED
  REPORT_REOPENED
  PAGE_DISABLED
  PAGE_RESTORED
  USER_DISABLED
  USER_RESTORED
  APPEAL_CREATED
  APPEAL_ACCEPTED
  APPEAL_REJECTED
  RETENTION_SUCCEEDED
  RETENTION_FAILED
  DELETION_REQUESTED
  DELETION_COMPLETED
  DELETION_RETRY_REQUESTED
  DELETION_ATTENTION_REQUIRED
  PROCESSOR_RECOVERY_RECORDED
  UPLOAD_SETTLEMENT_RECORDED
  DELETION_CHILD_ATTACHED
}

enum AuditOutcome {
  SUCCESS
  DENIED
  CONFLICT
  FAILURE
}

enum RetentionRecordType {
  PAGE_REPORT
  MODERATION_ACTION
  APPEAL
  AUDIT_EVENT
  ADMIN_IDEMPOTENCY
}

enum PageStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
  ARCHIVED
}

enum PageImageState {
  UPLOADING
  VERIFYING
  SANITIZING
  READY
  FAILED
  EXPIRED
}

enum PageAudioState {
  UPLOADING
  VERIFYING
  READY
  FAILED
  EXPIRED
}

enum PageAudioLinkProvider {
  YOUTUBE
}

enum MediaCleanupStatus {
  PENDING
  REVIEW
}

enum PageQuestionType {
  CHOICE
  PLAIN_MESSAGE
}

enum VisitorSubmissionReadState {
  UNREAD
  READ
}

enum PageReportReason {
  INAPPROPRIATE_CONTENT
  HARASSMENT
  SPAM
  PERSONAL_INFORMATION
  OTHER
}

enum PageReportStatus {
  OPEN
  REVIEWED
  DISMISSED
}

model User {
  id                            String                   @id
  name                          String
  email                         String
  emailVerified                 Boolean                  @default(false)
  image                         String?
  role                          UserRole                 @default(CREATOR)
  moderationStatus              ModerationStatus         @default(ACTIVE)
  disabledAt                    DateTime?
  disabledReason                String?
  moderationVersion             Int                      @default(0)
  deletionRequestedAt           DateTime?
  requestedDeletionJobs         DeletionJob[]
  createdAt                     DateTime                 @default(now())
  updatedAt                     DateTime                 @updatedAt
  sessions                      Session[]
  accounts                      Account[]
  pages                         Page[]
  moderationActionsAsActor      ModerationAction[]       @relation("ModerationActor")
  moderationActionsAsUserTarget ModerationAction[]       @relation("ModerationUserTarget")
  auditEventsAsActor            AuditEvent[]             @relation("AuditActor")
  resolvedAppeals               Appeal[]                 @relation("AppealResolver")
  adminIdempotencyRecords       AdminIdempotencyRecord[]

  @@unique([email])
  @@index([createdAt, id])
  @@index([moderationStatus, createdAt, id])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Category {
  id           String        @id @default(uuid()) @db.Uuid
  key          String        @unique
  name         String
  description  String?
  status       CatalogStatus @default(ACTIVE)
  displayOrder Int
  templates    Template[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status, displayOrder, id])
}

model Template {
  id           String            @id @default(uuid()) @db.Uuid
  categoryId   String            @db.Uuid
  category     Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  key          String
  name         String
  description  String?
  status       CatalogStatus     @default(ACTIVE)
  displayOrder Int
  versions     TemplateVersion[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([categoryId, key])
  @@index([status, displayOrder, id])
  @@index([categoryId, status, displayOrder, id])
}

model TemplateVersion {
  id          String        @id @default(uuid()) @db.Uuid
  templateId  String        @db.Uuid
  template    Template      @relation(fields: [templateId], references: [id], onDelete: Restrict)
  version     Int
  registryKey String        @unique
  status      CatalogStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  pages       Page[]

  @@unique([templateId, version])
  @@index([templateId, status, version])
}

model Page {
  id                  String                @id @default(uuid()) @db.Uuid
  creatorId           String
  creator             User                  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  templateVersionId   String                @db.Uuid
  templateVersion     TemplateVersion       @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)
  slug                String                @unique
  displaySlug         String
  status              PageStatus            @default(DRAFT)
  contentVersion      Int                   @default(0)
  content             Json
  settings            Json
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  publishedAt         DateTime?
  unpublishedAt       DateTime?
  archivedAt          DateTime?
  expiresAt           DateTime?
  moderationStatus    ModerationStatus      @default(ACTIVE)
  disabledAt          DateTime?
  disabledReason      String?
  moderationVersion   Int                   @default(0)
  deletionRequestedAt DateTime?
  currentAudioId      String?               @unique @db.Uuid
  currentAudio        PageAudio?            @relation("PageCurrentAudio", fields: [currentAudioId], references: [id], onDelete: SetNull)
  currentAudioLinkId  String?               @unique @db.Uuid
  currentAudioLink    PageAudioLink?        @relation("PageCurrentAudioLink", fields: [currentAudioLinkId], references: [id], onDelete: SetNull)
  slugReservations    PageSlugReservation[]
  images              PageImage[]
  audioUploads        PageAudio[]           @relation("PageAudioUploads")
  audioLinks          PageAudioLink[]       @relation("PageAudioLinkUploads")
  questions           PageQuestion[]
  pageJourney         PageJourney?
  submissions         VisitorSubmission[]
  visits              PageVisit[]
  viewSessions        PageViewSession[]
  reports             PageReport[]
  moderationActions   ModerationAction[]    @relation("ModerationPageTarget")

  @@index([creatorId, status, updatedAt])
  @@index([createdAt, id])
  @@index([creatorId, createdAt, id])
  @@index([status, createdAt, id])
  @@index([moderationStatus, createdAt, id])
  @@index([templateVersionId])
}

model PageJourney {
  id                  String                     @id @default(uuid()) @db.Uuid
  pageId              String                     @unique @db.Uuid
  page                Page                       @relation(fields: [pageId], references: [id], onDelete: Cascade)
  schemaVersion       Int                        @default(1)
  draftRevisionId     String                     @unique @db.Uuid
  draftRevision       PageJourneyGraphRevision   @relation("PageJourneyDraftRevision", fields: [draftRevisionId], references: [id], onDelete: Restrict)
  publishedRevisionId String?                    @unique @db.Uuid
  publishedRevision   PageJourneyGraphRevision?  @relation("PageJourneyPublishedRevision", fields: [publishedRevisionId], references: [id], onDelete: SetNull)
  nextRevisionNumber  Int                        @default(2)
  revisions           PageJourneyGraphRevision[] @relation("PageJourneyRevisions")
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
}

model PageJourneyGraphRevision {
  id             String                @id @default(uuid()) @db.Uuid
  journeyId      String                @db.Uuid
  journey        PageJourney           @relation("PageJourneyRevisions", fields: [journeyId], references: [id], onDelete: Cascade)
  revisionNumber Int
  rootQuestionId String                @unique @db.Uuid
  rootQuestion   PageJourneyQuestion   @relation("PageJourneyRevisionRootQuestion", fields: [rootQuestionId], references: [id], onDelete: Restrict)
  questions      PageJourneyQuestion[] @relation("PageJourneyRevisionQuestions")
  outcomes       PageJourneyOutcome[]  @relation("PageJourneyRevisionOutcomes")
  draftFor       PageJourney?          @relation("PageJourneyDraftRevision")
  publishedFor   PageJourney?          @relation("PageJourneyPublishedRevision")
  maxDepth       Int
  createdAt      DateTime              @default(now())

  @@unique([journeyId, revisionNumber])
  @@index([journeyId, createdAt])
}

model PageJourneyQuestion {
  id              String                    @id @default(uuid()) @db.Uuid
  revisionId      String                    @db.Uuid
  revision        PageJourneyGraphRevision  @relation("PageJourneyRevisionQuestions", fields: [revisionId], references: [id], onDelete: Cascade)
  rootOfRevision  PageJourneyGraphRevision? @relation("PageJourneyRevisionRootQuestion")
  incomingChoices PageJourneyChoice[]       @relation("PageJourneyChoiceNextQuestion")
  key             String
  prompt          String
  displayOrder    Int
  choices         PageJourneyChoice[]
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  @@unique([revisionId, key])
  @@unique([revisionId, displayOrder])
  @@index([revisionId, displayOrder])
}

model PageJourneyChoice {
  id             String               @id @default(uuid()) @db.Uuid
  questionId     String               @db.Uuid
  question       PageJourneyQuestion  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  key            String
  label          String
  displayOrder   Int
  nextQuestionId String?              @db.Uuid
  nextQuestion   PageJourneyQuestion? @relation("PageJourneyChoiceNextQuestion", fields: [nextQuestionId], references: [id], onDelete: SetNull)
  outcomeId      String?              @db.Uuid
  outcome        PageJourneyOutcome?  @relation(fields: [outcomeId], references: [id], onDelete: SetNull)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([questionId, key])
  @@unique([questionId, displayOrder])
  @@index([questionId, displayOrder])
  @@index([nextQuestionId])
  @@index([outcomeId])
}

model PageJourneyOutcome {
  id            String                   @id @default(uuid()) @db.Uuid
  revisionId    String                   @db.Uuid
  revision      PageJourneyGraphRevision @relation("PageJourneyRevisionOutcomes", fields: [revisionId], references: [id], onDelete: Cascade)
  key           String
  title         String
  resultMessage String
  displayOrder  Int
  choices       PageJourneyChoice[]
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  @@unique([revisionId, key])
  @@unique([revisionId, displayOrder])
  @@index([revisionId, displayOrder])
}

model PageSlugReservation {
  id             String   @id @default(uuid()) @db.Uuid
  normalizedSlug String   @unique
  pageId         String?  @db.Uuid
  page           Page?    @relation(fields: [pageId], references: [id], onDelete: SetNull)
  reservedAt     DateTime @default(now())
  isCurrent      Boolean  @default(true)

  @@index([pageId, isCurrent])
}

model PageImage {
  id                       String               @id @default(uuid()) @db.Uuid
  pageId                   String               @db.Uuid
  page                     Page                 @relation(fields: [pageId], references: [id], onDelete: Cascade)
  state                    PageImageState       @default(UPLOADING)
  attachedAt               DateTime?
  storageKey               String?
  sourceStorageKey         String?
  sourceMimeType           String
  sourceByteSize           Int
  sourceSha256             String
  outputByteSize           Int?
  outputSha256             String?
  width                    Int?
  height                   Int?
  sortOrder                Int?
  caption                  String?
  replaceImageId           String?              @db.Uuid
  failureCode              String?
  processingLeaseExpiresAt DateTime?
  attemptToken             String?              @db.Uuid
  processingState          MediaProcessingState @default(IDLE)
  processingInstanceId     String?              @db.Uuid
  processingHostIdentity   Json?
  processingStartedAt      DateTime?
  settledAt                DateTime?
  outputManifest           Json                 @default("[]")
  storageWriteState        StorageWriteState    @default(NONE)
  uploadExpiresAt          DateTime
  expiresAt                DateTime?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt

  @@unique([pageId, sortOrder])
  @@index([pageId, state, updatedAt])
  @@index([pageId, attachedAt, sortOrder])
  @@index([expiresAt])
  @@index([processingInstanceId, processingState])
}

model PageAudio {
  id                       String               @id @default(uuid()) @db.Uuid
  pageId                   String               @db.Uuid
  page                     Page                 @relation("PageAudioUploads", fields: [pageId], references: [id], onDelete: Cascade)
  currentForPage           Page?                @relation("PageCurrentAudio")
  state                    PageAudioState       @default(UPLOADING)
  sourceStorageKey         String?
  sourceMimeType           String
  displayTitle             String
  sourceByteSize           Int
  sourceSha256             String
  durationMilliseconds     Int?
  rightsConfirmedAt        DateTime?
  rightsStatementVersion   String?
  failureCode              String?
  processingLeaseExpiresAt DateTime?
  attemptToken             String?              @db.Uuid
  processingState          MediaProcessingState @default(IDLE)
  processingInstanceId     String?              @db.Uuid
  processingHostIdentity   Json?
  processingStartedAt      DateTime?
  settledAt                DateTime?
  outputManifest           Json                 @default("[]")
  storageWriteState        StorageWriteState    @default(NONE)
  uploadExpiresAt          DateTime
  expiresAt                DateTime?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt

  @@index([pageId, state, updatedAt])
  @@index([expiresAt])
  @@index([processingInstanceId, processingState])
}

model PageAudioLink {
  id             String                @id @default(uuid()) @db.Uuid
  pageId         String                @unique @db.Uuid
  page           Page                  @relation("PageAudioLinkUploads", fields: [pageId], references: [id], onDelete: Cascade)
  currentForPage Page?                 @relation("PageCurrentAudioLink")
  provider       PageAudioLinkProvider @default(YOUTUBE)
  videoId        String                @db.VarChar(11)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([videoId])
}

model MediaCleanup {
  id              String             @id @default(uuid()) @db.Uuid
  objectKey       String             @unique
  status          MediaCleanupStatus @default(PENDING)
  attempts        Int                @default(0)
  nextRetryAt     DateTime?
  lastFailureCode String?
  leaseOwner      String?
  leaseExpiresAt  DateTime?
  createdAt       DateTime           @default(now())
  deletionLinks   DeletionJobMedia[]

  @@index([status, nextRetryAt])
  @@index([leaseExpiresAt])
}

enum DeletionTargetType {
  CREATOR
  PAGE
}

enum DeletionJobState {
  QUEUED
  DATABASE_CLEANUP
  WAITING_FOR_CHILDREN
  MEDIA_CLEANUP
  RETRY_WAIT
  NEEDS_ATTENTION
  COMPLETED
}

enum MediaProcessingState {
  IDLE
  RUNNING
  QUIESCED
  UNCERTAIN
}

enum StorageWriteState {
  NONE
  IN_FLIGHT
  SETTLED
  UNCERTAIN
}

enum UploadMediaType {
  IMAGE
  AUDIO
}

model DeletionJob {
  id                        String                      @id @default(uuid()) @db.Uuid
  targetType                DeletionTargetType
  targetId                  String                      @db.VarChar(200)
  requestedById             String?
  requestedBy               User?                       @relation(fields: [requestedById], references: [id], onDelete: SetNull)
  parentJobId               String?                     @db.Uuid
  parentJob                 DeletionJob?                @relation("DeletionChildren", fields: [parentJobId], references: [id], onDelete: Restrict)
  children                  DeletionJob[]               @relation("DeletionChildren")
  reasonCode                PageReportReason
  note                      String?                     @db.VarChar(500)
  state                     DeletionJobState            @default(QUEUED)
  resumeState               DeletionJobState?
  requestedAt               DateTime                    @default(now())
  startedAt                 DateTime?
  completedAt               DateTime?
  nextRetryAt               DateTime?
  leaseOwner                String?                     @db.Uuid
  leaseExpiresAt            DateTime?
  lastFailureCode           String?                     @db.VarChar(50)
  attempts                  Int                         @default(0)
  version                   Int                         @default(0)
  pagesTotal                Int                         @default(0)
  pagesCompleted            Int                         @default(0)
  databaseBatchesCompleted  Int                         @default(0)
  mediaTotal                Int                         @default(0)
  mediaCompleted            Int                         @default(0)
  uploadsSafeAfter          DateTime?
  uploadGrantsTotal         Int                         @default(0)
  uploadManifestSha256      String?                     @db.VarChar(64)
  uploadsSettledAt          DateTime?
  retryChildrenAfterId      String?                     @db.Uuid
  retryChildrenRequested    Boolean                     @default(false)
  retryChildrenById         String?
  discoverPagesAfterId      String?                     @db.Uuid
  creatorDiscoveryCompleted Boolean                     @default(false)
  detachedPage              Boolean                     @default(false)
  media                     DeletionJobMedia[]
  receipts                  DeletionAcceptanceReceipt[]
  processorRecoveries       MediaProcessingRecovery[]
  uploadSettlement          UploadGrantSettlement?

  @@unique([targetType, targetId])
  @@index([state, nextRetryAt, requestedAt, id])
  @@index([leaseExpiresAt])
  @@index([parentJobId])
  @@index([completedAt])
}

model DeletionJobMedia {
  id            String        @id @default(uuid()) @db.Uuid
  jobId         String        @db.Uuid
  job           DeletionJob   @relation(fields: [jobId], references: [id], onDelete: Restrict)
  cleanupTaskId String?       @db.Uuid
  cleanupTask   MediaCleanup? @relation(fields: [cleanupTaskId], references: [id], onDelete: SetNull)
  completedAt   DateTime?

  @@unique([jobId, cleanupTaskId])
  @@index([jobId])
}

model DeletionAcceptanceReceipt {
  id                   String      @id @default(uuid()) @db.Uuid
  actorId              String      @db.VarChar(200)
  operation            String      @db.VarChar(30)
  idempotencyKey       String      @db.VarChar(200)
  canonicalPayloadHash String      @db.VarChar(64)
  jobId                String      @db.Uuid
  job                  DeletionJob @relation(fields: [jobId], references: [id], onDelete: Restrict)
  acceptedAt           DateTime    @default(now())

  @@unique([actorId, operation, idempotencyKey])
}

model PageUploadGrant {
  id        String          @id @default(uuid()) @db.Uuid
  pageId    String          @db.Uuid
  creatorId String?
  mediaType UploadMediaType
  mediaId   String          @db.Uuid
  objectKey String
  issuedAt  DateTime
  expiresAt DateTime
  createdAt DateTime        @default(now())

  @@index([pageId, id])
  @@index([creatorId, pageId, id])
  @@index([mediaType, mediaId])
}

model MediaProcessingRecovery {
  id                   String          @id @default(uuid()) @db.Uuid
  jobId                String          @db.Uuid
  job                  DeletionJob     @relation(fields: [jobId], references: [id], onDelete: Restrict)
  mediaType            UploadMediaType
  mediaId              String          @db.Uuid
  pageId               String          @db.Uuid
  attemptToken         String          @db.Uuid
  processingInstanceId String          @db.Uuid
  operatorId           String          @db.VarChar(200)
  manifestSha256       String          @db.VarChar(64)
  evidenceSha256       String          @db.VarChar(64)
  evidence             Json
  recordedAt           DateTime        @default(now())

  @@unique([mediaType, mediaId, attemptToken])
  @@index([jobId])
}

model UploadGrantSettlement {
  id                   String      @id @default(uuid()) @db.Uuid
  jobId                String      @unique @db.Uuid
  job                  DeletionJob @relation(fields: [jobId], references: [id], onDelete: Restrict)
  operatorId           String      @db.VarChar(200)
  uploadManifestSha256 String      @db.VarChar(64)
  evidenceSha256       String      @db.VarChar(64)
  evidence             Json
  recordedAt           DateTime    @default(now())
}

model PageQuestion {
  id                String           @id @default(uuid()) @db.Uuid
  pageId            String           @db.Uuid
  page              Page             @relation(fields: [pageId], references: [id], onDelete: Cascade)
  key               String
  type              PageQuestionType
  prompt            String
  displayOrder      Int
  config            Json?
  endsJourney       Boolean          @default(false)
  nextQuestionId    String?          @db.Uuid
  nextQuestion      PageQuestion?    @relation("QuestionNext", fields: [nextQuestionId], references: [id], onDelete: SetNull)
  previousQuestions PageQuestion[]   @relation("QuestionNext")
  incomingChoices   PageChoice[]     @relation("ChoiceNext")
  choices           PageChoice[]
  answers           VisitorAnswer[]

  @@unique([pageId, key])
  @@index([pageId, displayOrder])
  @@index([nextQuestionId])
}

model PageChoice {
  id             String          @id @default(uuid()) @db.Uuid
  questionId     String          @db.Uuid
  question       PageQuestion    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  key            String
  label          String
  displayOrder   Int
  creatorMessage String?
  endsJourney    Boolean         @default(false)
  nextQuestionId String?         @db.Uuid
  nextQuestion   PageQuestion?   @relation("ChoiceNext", fields: [nextQuestionId], references: [id], onDelete: SetNull)
  answers        VisitorAnswer[]

  @@unique([questionId, key])
  @@index([questionId, displayOrder])
  @@index([nextQuestionId])
}

model VisitorSubmission {
  id                     String                     @id @default(uuid()) @db.Uuid
  pageId                 String                     @db.Uuid
  page                   Page                       @relation(fields: [pageId], references: [id], onDelete: Cascade)
  browserTokenHash       String
  idempotencyKey         String
  idempotencyPayloadHash String
  readState              VisitorSubmissionReadState @default(UNREAD)
  submittedAt            DateTime                   @default(now())
  deletedAt              DateTime?
  journeySnapshot        Json?
  journeyAnswerCount     Int?
  answers                VisitorAnswer[]
  visitorMessage         VisitorMessage?

  @@unique([pageId, browserTokenHash])
  @@unique([pageId, idempotencyKey])
  @@index([pageId, submittedAt, id])
  @@index([pageId, readState, submittedAt, id])
}

model PageVisit {
  id               String   @id @default(uuid()) @db.Uuid
  pageId           String   @db.Uuid
  page             Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  browserTokenHash String
  visitedOn        DateTime @db.Date
  viewCount        Int      @default(1)

  @@unique([pageId, browserTokenHash, visitedOn])
  @@index([pageId, visitedOn])
}

model DailyAdminMetrics {
  day             DateTime @id @db.Date
  creatorSignups  BigInt   @default(0)
  pagesCreated    BigInt   @default(0)
  publishActions  BigInt   @default(0)
  pageViews       BigInt   @default(0)
  dailyPageVisits BigInt   @default(0)
}

model AnalyticsCoverage {
  id        String   @id
  startedAt DateTime @db.Timestamptz(6)
}

model PageViewSession {
  id               String   @id @default(uuid()) @db.Uuid
  pageId           String   @db.Uuid
  page             Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  browserTokenHash String
  startedAt        DateTime @default(now())
  activeSeconds    Int      @default(0)

  @@index([pageId, startedAt])
}

model VisitorAnswer {
  id                  String            @id @default(uuid()) @db.Uuid
  submissionId        String            @db.Uuid
  submission          VisitorSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  questionId          String            @db.Uuid
  question            PageQuestion      @relation(fields: [questionId], references: [id], onDelete: Restrict)
  choiceId            String?           @db.Uuid
  choice              PageChoice?       @relation(fields: [choiceId], references: [id], onDelete: SetNull)
  textAnswer          String?
  promptSnapshot      String
  choiceLabelSnapshot String?
  answerOrder         Int

  @@unique([submissionId, questionId])
  @@index([submissionId, answerOrder])
  @@index([questionId])
  @@index([choiceId])
}

model VisitorMessage {
  id             String            @id @default(uuid()) @db.Uuid
  submissionId   String            @unique @db.Uuid
  submission     VisitorSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  promptSnapshot String
  message        String
  createdAt      DateTime          @default(now())
}

model PageReport {
  id                String             @id @default(uuid()) @db.Uuid
  pageId            String             @db.Uuid
  page              Page               @relation(fields: [pageId], references: [id], onDelete: Cascade)
  reason            PageReportReason
  message           String?
  status            PageReportStatus   @default(OPEN)
  moderationVersion Int                @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  moderationActions ModerationAction[] @relation("ModerationReportTarget")

  @@index([pageId, status, createdAt])
}

model ModerationAction {
  id             String               @id @default(uuid()) @db.Uuid
  targetType     ModerationTargetType
  targetId       String
  pageId         String?              @db.Uuid
  page           Page?                @relation("ModerationPageTarget", fields: [pageId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?                @relation("ModerationUserTarget", fields: [userId], references: [id], onDelete: Cascade)
  reportId       String?              @db.Uuid
  report         PageReport?          @relation("ModerationReportTarget", fields: [reportId], references: [id], onDelete: Cascade)
  appealId       String?              @db.Uuid
  appeal         Appeal?              @relation("ModerationAppealTarget", fields: [appealId], references: [id], onDelete: Cascade)
  actorId        String?
  actor          User?                @relation("ModerationActor", fields: [actorId], references: [id], onDelete: SetNull)
  actionType     ModerationActionType
  reasonCode     String
  note           String?
  previousState  String
  resultingState String
  requestId      String
  createdAt      DateTime             @default(now())
  appealOrigin   Appeal?              @relation("AppealOriginalAction")

  @@index([targetType, targetId, createdAt, id])
  @@index([actorId, createdAt, id])
  @@index([reportId, createdAt, id])
}

model Appeal {
  id                String             @id @default(uuid()) @db.Uuid
  originalActionId  String             @unique @db.Uuid
  originalAction    ModerationAction   @relation("AppealOriginalAction", fields: [originalActionId], references: [id], onDelete: Cascade)
  status            AppealStatus       @default(REQUESTED)
  externalReference String
  reasonCode        PageReportReason
  moderationVersion Int                @default(0)
  requestedAt       DateTime           @default(now())
  resolvedAt        DateTime?
  resolvedById      String?
  resolvedBy        User?              @relation("AppealResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  actions           ModerationAction[] @relation("ModerationAppealTarget")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([status, requestedAt, id])
  @@index([createdAt, id])
  @@index([status, createdAt, id])
}

model AuditEvent {
  id         String           @id @default(uuid()) @db.Uuid
  actorId    String?
  actor      User?            @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  eventType  AuditEventType
  targetType AuditTargetType?
  targetId   String?
  requestId  String?
  outcome    AuditOutcome
  metadata   Json?
  createdAt  DateTime         @default(now())

  @@index([targetType, targetId, createdAt, id])
  @@index([actorId, createdAt, id])
  @@index([eventType, createdAt, id])
}

model AdminIdempotencyRecord {
  id             String               @id @default(uuid()) @db.Uuid
  actorId        String
  actor          User                 @relation(fields: [actorId], references: [id], onDelete: Cascade)
  operation      String
  targetType     ModerationTargetType
  targetId       String
  key            String
  payloadHash    String
  resultSnapshot Json
  outcome        AuditOutcome
  createdAt      DateTime             @default(now())
  expiresAt      DateTime

  @@unique([actorId, operation, targetType, targetId, key])
  @@index([expiresAt])
}

model RetentionClaim {
  id              String              @id @default(uuid()) @db.Uuid
  recordType      RetentionRecordType
  recordId        String
  claimToken      String
  claimedAt       DateTime            @default(now())
  claimExpiresAt  DateTime
  attempts        Int                 @default(0)
  lastFailureCode String?

  @@unique([recordType, recordId])
  @@index([claimExpiresAt])
}

model JobLease {
  id             String   @id @default(uuid()) @db.Uuid
  jobName        String   @unique
  leaseToken     String
  leasedAt       DateTime @default(now())
  leaseExpiresAt DateTime

  @@index([leaseExpiresAt])
}
