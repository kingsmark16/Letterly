generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CatalogStatus {
  ACTIVE
  INACTIVE
}

enum UserRole {
  CREATOR
  ADMIN
}

enum ModerationStatus {
  ACTIVE
  DISABLED
}

enum ModerationTargetType {
  PAGE
  USER
  REPORT
  APPEAL
}

enum ModerationActionType {
  REPORT_REVIEW
  REPORT_DISMISS
  REPORT_REOPEN
  PAGE_DISABLE
  PAGE_RESTORE
  USER_DISABLE
  USER_RESTORE
  APPEAL_CREATE
  APPEAL_ACCEPT
  APPEAL_REJECT
}

enum AppealStatus {
  REQUESTED
  ACCEPTED
  REJECTED
}

enum AuditTargetType {
  PAGE
  USER
  REPORT
  APPEAL
  SYSTEM
}

enum AuditEventType {
  AUTH_SIGN_IN_SUCCEEDED
  AUTH_SIGN_IN_DENIED
  ADMIN_BOOTSTRAPPED
  REPORT_CREATED
  REPORT_REVIEWED
  REPORT_DISMISSED
  REPORT_REOPENED
  PAGE_DISABLED
  PAGE_RESTORED
  USER_DISABLED
  USER_RESTORED
  APPEAL_CREATED
  APPEAL_ACCEPTED
  APPEAL_REJECTED
  RETENTION_SUCCEEDED
  RETENTION_FAILED
}

enum AuditOutcome {
  SUCCESS
  DENIED
  CONFLICT
  FAILURE
}

enum RetentionRecordType {
  PAGE_REPORT
  MODERATION_ACTION
  APPEAL
  AUDIT_EVENT
  ADMIN_IDEMPOTENCY
}

enum PageStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
  ARCHIVED
}

enum PageImageState {
  UPLOADING
  VERIFYING
  SANITIZING
  READY
  FAILED
  EXPIRED
}

enum MediaCleanupStatus {
  PENDING
  REVIEW
}

enum PageQuestionType {
  CHOICE
  PLAIN_MESSAGE
}

enum VisitorSubmissionReadState {
  UNREAD
  READ
}

enum PageReportReason {
  INAPPROPRIATE_CONTENT
  HARASSMENT
  SPAM
  PERSONAL_INFORMATION
  OTHER
}

enum PageReportStatus {
  OPEN
  REVIEWED
  DISMISSED
}

model User {
  id                            String                   @id
  name                          String
  email                         String
  emailVerified                 Boolean                  @default(false)
  image                         String?
  role                          UserRole                 @default(CREATOR)
  moderationStatus              ModerationStatus         @default(ACTIVE)
  disabledAt                    DateTime?
  disabledReason                String?
  moderationVersion             Int                      @default(0)
  createdAt                     DateTime                 @default(now())
  updatedAt                     DateTime                 @updatedAt
  sessions                      Session[]
  accounts                      Account[]
  pages                         Page[]
  moderationActionsAsActor      ModerationAction[]       @relation("ModerationActor")
  moderationActionsAsUserTarget ModerationAction[]       @relation("ModerationUserTarget")
  auditEventsAsActor            AuditEvent[]             @relation("AuditActor")
  resolvedAppeals               Appeal[]                 @relation("AppealResolver")
  adminIdempotencyRecords       AdminIdempotencyRecord[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Category {
  id           String        @id @default(uuid()) @db.Uuid
  key          String        @unique
  name         String
  description  String?
  status       CatalogStatus @default(ACTIVE)
  displayOrder Int
  templates    Template[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status, displayOrder])
}

model Template {
  id           String            @id @default(uuid()) @db.Uuid
  categoryId   String            @db.Uuid
  category     Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  key          String
  name         String
  description  String?
  status       CatalogStatus     @default(ACTIVE)
  displayOrder Int
  versions     TemplateVersion[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([categoryId, key])
  @@index([categoryId, status, displayOrder])
}

model TemplateVersion {
  id          String        @id @default(uuid()) @db.Uuid
  templateId  String        @db.Uuid
  template    Template      @relation(fields: [templateId], references: [id], onDelete: Restrict)
  version     Int
  registryKey String        @unique
  status      CatalogStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  pages       Page[]

  @@unique([templateId, version])
  @@index([templateId, status])
}

model Page {
  id                String                @id @default(uuid()) @db.Uuid
  creatorId         String
  creator           User                  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  templateVersionId String                @db.Uuid
  templateVersion   TemplateVersion       @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)
  slug              String                @unique
  displaySlug       String
  status            PageStatus            @default(DRAFT)
  contentVersion    Int                   @default(0)
  content           Json
  settings          Json
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  publishedAt       DateTime?
  unpublishedAt     DateTime?
  archivedAt        DateTime?
  expiresAt         DateTime?
  moderationStatus  ModerationStatus      @default(ACTIVE)
  disabledAt        DateTime?
  disabledReason    String?
  moderationVersion Int                   @default(0)
  slugReservations  PageSlugReservation[]
  images            PageImage[]
  questions         PageQuestion[]
  pageJourney       PageJourney?
  submissions       VisitorSubmission[]
  reports           PageReport[]
  moderationActions ModerationAction[]    @relation("ModerationPageTarget")

  @@index([creatorId, status, updatedAt])
  @@index([templateVersionId])
}

model PageJourney {
  id                  String                     @id @default(uuid()) @db.Uuid
  pageId              String                     @unique @db.Uuid
  page                Page                       @relation(fields: [pageId], references: [id], onDelete: Cascade)
  schemaVersion       Int                        @default(1)
  draftRevisionId     String                     @unique @db.Uuid
  draftRevision       PageJourneyGraphRevision   @relation("PageJourneyDraftRevision", fields: [draftRevisionId], references: [id], onDelete: Restrict)
  publishedRevisionId String?                    @unique @db.Uuid
  publishedRevision   PageJourneyGraphRevision?  @relation("PageJourneyPublishedRevision", fields: [publishedRevisionId], references: [id], onDelete: SetNull)
  nextRevisionNumber  Int                        @default(2)
  revisions           PageJourneyGraphRevision[] @relation("PageJourneyRevisions")
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
}

model PageJourneyGraphRevision {
  id             String                @id @default(uuid()) @db.Uuid
  journeyId      String                @db.Uuid
  journey        PageJourney           @relation("PageJourneyRevisions", fields: [journeyId], references: [id], onDelete: Cascade)
  revisionNumber Int
  rootQuestionId String                @unique @db.Uuid
  rootQuestion   PageJourneyQuestion   @relation("PageJourneyRevisionRootQuestion", fields: [rootQuestionId], references: [id], onDelete: Restrict)
  questions      PageJourneyQuestion[] @relation("PageJourneyRevisionQuestions")
  outcomes       PageJourneyOutcome[]  @relation("PageJourneyRevisionOutcomes")
  draftFor       PageJourney?          @relation("PageJourneyDraftRevision")
  publishedFor   PageJourney?          @relation("PageJourneyPublishedRevision")
  maxDepth       Int
  createdAt      DateTime              @default(now())

  @@unique([journeyId, revisionNumber])
  @@index([journeyId, createdAt])
}

model PageJourneyQuestion {
  id              String                    @id @default(uuid()) @db.Uuid
  revisionId      String                    @db.Uuid
  revision        PageJourneyGraphRevision  @relation("PageJourneyRevisionQuestions", fields: [revisionId], references: [id], onDelete: Cascade)
  rootOfRevision  PageJourneyGraphRevision? @relation("PageJourneyRevisionRootQuestion")
  incomingChoices PageJourneyChoice[]       @relation("PageJourneyChoiceNextQuestion")
  key             String
  prompt          String
  displayOrder    Int
  choices         PageJourneyChoice[]
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  @@unique([revisionId, key])
  @@unique([revisionId, displayOrder])
  @@index([revisionId, displayOrder])
}

model PageJourneyChoice {
  id             String               @id @default(uuid()) @db.Uuid
  questionId     String               @db.Uuid
  question       PageJourneyQuestion  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  key            String
  label          String
  displayOrder   Int
  nextQuestionId String?              @db.Uuid
  nextQuestion   PageJourneyQuestion? @relation("PageJourneyChoiceNextQuestion", fields: [nextQuestionId], references: [id], onDelete: SetNull)
  outcomeId      String?              @db.Uuid
  outcome        PageJourneyOutcome?  @relation(fields: [outcomeId], references: [id], onDelete: SetNull)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([questionId, key])
  @@unique([questionId, displayOrder])
  @@index([questionId, displayOrder])
  @@index([nextQuestionId])
  @@index([outcomeId])
}

model PageJourneyOutcome {
  id            String                   @id @default(uuid()) @db.Uuid
  revisionId    String                   @db.Uuid
  revision      PageJourneyGraphRevision @relation("PageJourneyRevisionOutcomes", fields: [revisionId], references: [id], onDelete: Cascade)
  key           String
  title         String
  resultMessage String
  displayOrder  Int
  choices       PageJourneyChoice[]
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  @@unique([revisionId, key])
  @@unique([revisionId, displayOrder])
  @@index([revisionId, displayOrder])
}

model PageSlugReservation {
  id             String   @id @default(uuid()) @db.Uuid
  normalizedSlug String   @unique
  pageId         String?  @db.Uuid
  page           Page?    @relation(fields: [pageId], references: [id], onDelete: SetNull)
  reservedAt     DateTime @default(now())
  isCurrent      Boolean  @default(true)

  @@index([pageId, isCurrent])
}

model PageImage {
  id                       String         @id @default(uuid()) @db.Uuid
  pageId                   String         @db.Uuid
  page                     Page           @relation(fields: [pageId], references: [id], onDelete: Cascade)
  state                    PageImageState @default(UPLOADING)
  attachedAt               DateTime?
  storageKey               String?
  sourceStorageKey         String?
  sourceMimeType           String
  sourceByteSize           Int
  sourceSha256             String
  outputByteSize           Int?
  outputSha256             String?
  width                    Int?
  height                   Int?
  sortOrder                Int?
  caption                  String?
  replaceImageId           String?        @db.Uuid
  failureCode              String?
  processingLeaseExpiresAt DateTime?
  uploadExpiresAt          DateTime
  expiresAt                DateTime?
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt

  @@unique([pageId, sortOrder])
  @@index([pageId, state, updatedAt])
  @@index([pageId, attachedAt, sortOrder])
  @@index([expiresAt])
}

model MediaCleanup {
  id              String             @id @default(uuid()) @db.Uuid
  objectKey       String             @unique
  status          MediaCleanupStatus @default(PENDING)
  attempts        Int                @default(0)
  nextRetryAt     DateTime?
  lastFailureCode String?
  leaseOwner      String?
  leaseExpiresAt  DateTime?
  createdAt       DateTime           @default(now())

  @@index([status, nextRetryAt])
  @@index([leaseExpiresAt])
}

model PageQuestion {
  id                String           @id @default(uuid()) @db.Uuid
  pageId            String           @db.Uuid
  page              Page             @relation(fields: [pageId], references: [id], onDelete: Cascade)
  key               String
  type              PageQuestionType
  prompt            String
  displayOrder      Int
  config            Json?
  nextQuestionId    String?          @db.Uuid
  nextQuestion      PageQuestion?    @relation("QuestionNext", fields: [nextQuestionId], references: [id], onDelete: SetNull)
  previousQuestions PageQuestion[]   @relation("QuestionNext")
  incomingChoices   PageChoice[]     @relation("ChoiceNext")
  choices           PageChoice[]
  answers           VisitorAnswer[]

  @@unique([pageId, key])
  @@index([pageId, displayOrder])
  @@index([nextQuestionId])
}

model PageChoice {
  id             String          @id @default(uuid()) @db.Uuid
  questionId     String          @db.Uuid
  question       PageQuestion    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  key            String
  label          String
  displayOrder   Int
  creatorMessage String?
  nextQuestionId String?         @db.Uuid
  nextQuestion   PageQuestion?   @relation("ChoiceNext", fields: [nextQuestionId], references: [id], onDelete: SetNull)
  answers        VisitorAnswer[]

  @@unique([questionId, key])
  @@index([questionId, displayOrder])
  @@index([nextQuestionId])
}

model VisitorSubmission {
  id                     String                     @id @default(uuid()) @db.Uuid
  pageId                 String                     @db.Uuid
  page                   Page                       @relation(fields: [pageId], references: [id], onDelete: Cascade)
  browserTokenHash       String
  idempotencyKey         String
  idempotencyPayloadHash String
  readState              VisitorSubmissionReadState @default(UNREAD)
  submittedAt            DateTime                   @default(now())
  deletedAt              DateTime?
  journeySnapshot        Json?
  answers                VisitorAnswer[]
  visitorMessage         VisitorMessage?

  @@unique([pageId, browserTokenHash])
  @@unique([pageId, idempotencyKey])
  @@index([pageId, submittedAt, id])
  @@index([pageId, readState, submittedAt, id])
}

model VisitorAnswer {
  id                  String            @id @default(uuid()) @db.Uuid
  submissionId        String            @db.Uuid
  submission          VisitorSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  questionId          String            @db.Uuid
  question            PageQuestion      @relation(fields: [questionId], references: [id], onDelete: Restrict)
  choiceId            String?           @db.Uuid
  choice              PageChoice?       @relation(fields: [choiceId], references: [id], onDelete: SetNull)
  textAnswer          String?
  promptSnapshot      String
  choiceLabelSnapshot String?
  answerOrder         Int

  @@unique([submissionId, questionId])
  @@index([submissionId, answerOrder])
  @@index([questionId])
  @@index([choiceId])
}

model VisitorMessage {
  id             String            @id @default(uuid()) @db.Uuid
  submissionId   String            @unique @db.Uuid
  submission     VisitorSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  promptSnapshot String
  message        String
  createdAt      DateTime          @default(now())
}

model PageReport {
  id                String             @id @default(uuid()) @db.Uuid
  pageId            String             @db.Uuid
  page              Page               @relation(fields: [pageId], references: [id], onDelete: Cascade)
  reason            PageReportReason
  message           String?
  status            PageReportStatus   @default(OPEN)
  moderationVersion Int                @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  moderationActions ModerationAction[] @relation("ModerationReportTarget")

  @@index([pageId, status, createdAt])
}

model ModerationAction {
  id             String               @id @default(uuid()) @db.Uuid
  targetType     ModerationTargetType
  targetId       String
  pageId         String?              @db.Uuid
  page           Page?                @relation("ModerationPageTarget", fields: [pageId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?                @relation("ModerationUserTarget", fields: [userId], references: [id], onDelete: Cascade)
  reportId       String?              @db.Uuid
  report         PageReport?          @relation("ModerationReportTarget", fields: [reportId], references: [id], onDelete: Cascade)
  appealId       String?              @db.Uuid
  appeal         Appeal?              @relation("ModerationAppealTarget", fields: [appealId], references: [id], onDelete: Cascade)
  actorId        String?
  actor          User?                @relation("ModerationActor", fields: [actorId], references: [id], onDelete: SetNull)
  actionType     ModerationActionType
  reasonCode     String
  note           String?
  previousState  String
  resultingState String
  requestId      String
  createdAt      DateTime             @default(now())
  appealOrigin   Appeal?              @relation("AppealOriginalAction")

  @@index([targetType, targetId, createdAt, id])
  @@index([actorId, createdAt, id])
  @@index([reportId, createdAt, id])
}

model Appeal {
  id                String             @id @default(uuid()) @db.Uuid
  originalActionId  String             @unique @db.Uuid
  originalAction    ModerationAction   @relation("AppealOriginalAction", fields: [originalActionId], references: [id], onDelete: Cascade)
  status            AppealStatus       @default(REQUESTED)
  externalReference String
  reasonCode        PageReportReason
  moderationVersion Int                @default(0)
  requestedAt       DateTime           @default(now())
  resolvedAt        DateTime?
  resolvedById      String?
  resolvedBy        User?              @relation("AppealResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  actions           ModerationAction[] @relation("ModerationAppealTarget")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([status, requestedAt, id])
}

model AuditEvent {
  id         String           @id @default(uuid()) @db.Uuid
  actorId    String?
  actor      User?            @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  eventType  AuditEventType
  targetType AuditTargetType?
  targetId   String?
  requestId  String?
  outcome    AuditOutcome
  metadata   Json?
  createdAt  DateTime         @default(now())

  @@index([targetType, targetId, createdAt, id])
  @@index([actorId, createdAt, id])
  @@index([eventType, createdAt, id])
}

model AdminIdempotencyRecord {
  id             String               @id @default(uuid()) @db.Uuid
  actorId        String
  actor          User                 @relation(fields: [actorId], references: [id], onDelete: Cascade)
  operation      String
  targetType     ModerationTargetType
  targetId       String
  key            String
  payloadHash    String
  resultSnapshot Json
  outcome        AuditOutcome
  createdAt      DateTime             @default(now())
  expiresAt      DateTime

  @@unique([actorId, operation, targetType, targetId, key])
  @@index([expiresAt])
}

model RetentionClaim {
  id              String              @id @default(uuid()) @db.Uuid
  recordType      RetentionRecordType
  recordId        String
  claimToken      String
  claimedAt       DateTime            @default(now())
  claimExpiresAt  DateTime
  attempts        Int                 @default(0)
  lastFailureCode String?

  @@unique([recordType, recordId])
  @@index([claimExpiresAt])
}

model JobLease {
  id             String   @id @default(uuid()) @db.Uuid
  jobName        String   @unique
  leaseToken     String
  leasedAt       DateTime @default(now())
  leaseExpiresAt DateTime

  @@index([leaseExpiresAt])
}
