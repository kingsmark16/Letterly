# Browser facing origin used by Better Auth and canonical links.
APP_ORIGIN="http://localhost:3000"

# Server only API origin. Required outside development and test.
API_ORIGIN="http://localhost:3001"

# Server only. In production this must match the API value used to verify
# signed visitor identities. Leave empty only for local development.
BETTER_AUTH_SECRET=""

# Server only. In production this must match the API value used to verify
# signed visitor identities for public media.
PUBLIC_MEDIA_PROXY_SECRET=""

# Safe recovery contact shown on unavailable public pages.
PUBLIC_SUPPORT_CONTACT_URL="https://letterly.example/support"

# Number of trusted proxy hops that may supply the visitor address.
TRUSTED_PROXY_COUNT="1"

# Server fallback for Better Auth during build time. Browser requests use the
# origin currently open in the address bar, so localhost and 127.0.0.1 cannot
# split the session.
NEXT_PUBLIC_AUTH_URL="http://localhost:3000/api/auth"
