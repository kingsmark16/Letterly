# The Next.js browser application.
APP_ORIGIN="http://localhost:3000"

# The NestJS API and Better Auth server.
PORT=3001
BETTER_AUTH_URL="http://localhost:3000"

# Generate a unique value locally with Node's crypto randomBytes helper.
# Never commit the real value.
BETTER_AUTH_SECRET=""

# Shared atomic rate-limit storage. Required in production; memory is used only
# in development and test. Production must use a TLS URL with Redis
# authentication, for example rediss://:password@redis.internal:6380.
REDIS_URL="redis://localhost:6379"

# YouTube links stay disabled until the server only Data API key is configured.
YOUTUBE_LINKS_ENABLED="false"
YOUTUBE_DATA_API_KEY=""

# One time administrator provisioning and signed administration cursors.
ADMIN_BOOTSTRAP_SECRET=""
ADMIN_CURSOR_SIGNING_SECRET=""
PUBLIC_SUPPORT_CONTACT_URL="https://letterly.example/support"
MODERATION_RETENTION_DAYS="730"
MODERATION_PURGE_INTERVAL_SECONDS="86400"
MODERATION_PURGE_BATCH_SIZE="100"
ADMIN_READ_RATE_LIMIT="120"
ADMIN_WRITE_RATE_LIMIT="30"

# Optional Sentry error monitoring. Events are redacted before transport.
# SENTRY_DSN="https://public-key@sentry.example/1"
SENTRY_ENVIRONMENT="development"
# SENTRY_RELEASE="letterly-development"
SENTRY_TRACES_SAMPLE_RATE="0.1"

# Optional OAuth credentials. Uncomment both values for each provider you enable.
# GOOGLE_CLIENT_ID="replace-with-development-client-id"
# GOOGLE_CLIENT_SECRET="replace-with-development-client-secret"
# FACEBOOK_CLIENT_ID="replace-with-development-client-id"
# FACEBOOK_CLIENT_SECRET="replace-with-development-client-secret"

# Optional local OAuth relay for phones or previews.
# Set the public HTTPS tunnel origin and a dedicated secret of at least 32 characters.
# Register https://<tunnel-host>/api/auth/callback/google and
# https://<tunnel-host>/api/auth/callback/facebook with the OAuth providers.
OAUTH_PROXY_PRODUCTION_URL=""
OAUTH_PROXY_SECRET=""

# Local development uses the PostgreSQL service in docker-compose.yml.
DATABASE_URL="postgresql://letterly:letterly@localhost:5432/letterly_dev?schema=public"

# Optional private Cloudflare R2 storage for development media uploads.
# Uncomment and configure all four values together. Required in production.
# R2_ENDPOINT="https://account-id.r2.cloudflarestorage.com"
# R2_BUCKET="letterly-development"
# R2_ACCESS_KEY_ID="replace-with-development-access-key"
# R2_SECRET_ACCESS_KEY="replace-with-development-secret-key"

# Server only visitor signing and trusted proxy settings.
PUBLIC_MEDIA_PROXY_SECRET=""
TRUSTED_PROXY_COUNT="1"
# Comma separated IP addresses or CIDR ranges for reverse proxies allowed to
# forward a client address to the API. Leave empty for direct API traffic.
TRUSTED_PROXY_IPS=""

# External key material for AES 256 GCM page password encryption.
PAGE_PASSWORD_ENCRYPTION_KEY=""
PAGE_PASSWORD_ENCRYPTION_KEY_VERSION="1"
