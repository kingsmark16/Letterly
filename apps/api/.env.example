# The Next.js browser application.
APP_ORIGIN="http://localhost:3000"

# The NestJS API and Better Auth server.
PORT=3001
BETTER_AUTH_URL="http://localhost:3000"

# Generate a unique value with: pnpm dlx auth@latest secret
# Never commit the real value.
BETTER_AUTH_SECRET=""

# One time administrator provisioning and signed administration cursors.
ADMIN_BOOTSTRAP_SECRET=""
ADMIN_CURSOR_SIGNING_SECRET=""
PUBLIC_SUPPORT_CONTACT_URL="https://letterly.example/support"
MODERATION_RETENTION_DAYS="730"
MODERATION_PURGE_INTERVAL_SECONDS="86400"
MODERATION_PURGE_BATCH_SIZE="100"
ADMIN_READ_RATE_LIMIT="120"
ADMIN_WRITE_RATE_LIMIT="30"

# Optional Sentry error monitoring. Events are redacted before transport.
SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"
SENTRY_RELEASE=""
SENTRY_TRACES_SAMPLE_RATE="0.1"

# OAuth credentials. Configure both values for each provider you enable.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# Better Auth will use this pooled PostgreSQL connection through Prisma.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=verify-full&schema=public"

# Private Cloudflare R2 storage for creator image uploads.
R2_ENDPOINT="https://account-id.r2.cloudflarestorage.com"
R2_BUCKET="letterly-development"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""

# Server only visitor signing and trusted proxy settings.
PUBLIC_MEDIA_PROXY_SECRET=""
TRUSTED_PROXY_COUNT="1"

# External key material for AES 256 GCM page password encryption.
PAGE_PASSWORD_ENCRYPTION_KEY=""
PAGE_PASSWORD_ENCRYPTION_KEY_VERSION="1"
