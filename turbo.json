{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "APP_ORIGIN",
    "API_ORIGIN",
    "LETTERLY_UI_TEST_FIXTURES",
    "NODE_ENV"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        "dist/**",
        "generated/**"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "test": {
      "dependsOn": ["transit"]
    },
    "@letterly/templates#test": {
      "dependsOn": ["transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../apps/web/package.json",
        "../../packages/database/src/seed-catalog.ts",
        "../../pnpm-workspace.yaml"
      ]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "env": ["OAUTH_PROXY_PRODUCTION_URL", "API_STARTUP_TIMEOUT_MS"],
      "cache": false,
      "persistent": true
    }
  }
}
